# Shared Ollama server
OLLAMA_HOST=https://ollama.example.org
OLLAMA_API_KEY=replace-with-shared-bearer-token

# Model assignments (per role, not per request)
OGCAIBB_MODEL_CHAT=qwen2.5-coder:32b-instruct
OGCAIBB_MODEL_ROUTER=qwen2.5:7b-instruct
OGCAIBB_MODEL_EMBED=nomic-embed-text

# Daemon
OGCAIBB_HOST=127.0.0.1
OGCAIBB_PORT=4141
OGCAIBB_WORKSPACE_ROOT=/Users/you/repos
OGCAIBB_LOG_LEVEL=INFO

# Memory + vector store
OGCAIBB_MEMORY_DIR=~/.local/share/ogcaibb/memory
OGCAIBB_VECTOR_BACKEND=chroma
OGCAIBB_VECTOR_PATH=~/.local/share/ogcaibb/chroma

# --- Trace capture pipeline ------------------------------------------
# Set to 0 to disable trace capture entirely.
OGCAIBB_TRACE_ENABLED=1
OGCAIBB_TRACE_DIR=~/.local/share/ogcaibb/traces
OGCAIBB_TRACE_MAX_BYTES=4194304          # 4 MiB per chunk
OGCAIBB_TRACE_MAX_AGE_SECONDS=300        # rotate even if under size cap
OGCAIBB_TRACE_MAX_TOTAL_BYTES=209715200  # 200 MiB cap on local backlog

# Transport: noop | https
#   - noop  → traces stay on disk, no network calls (default until hub is up)
#   - https → ship sealed chunks to OGCAIBB_HUB_URL
OGCAIBB_TRACE_TRANSPORT=noop

# Redactor: ruleset (default). Optional YAML overrides for patterns/denylist.
OGCAIBB_REDACTOR=ruleset
# OGCAIBB_REDACTOR_RULES=~/.config/ogcaibb/redact.yaml

# Stable workstation identity (auto-generated on first run).
OGCAIBB_WORKSTATION_ID_PATH=~/.local/share/ogcaibb/workstation_id

# --- Hub client ------------------------------------------------------
# OGCAIBB_HUB_URL=https://hub.example.org
OGCAIBB_HUB_AUTH=apikey
# OGCAIBB_HUB_TOKEN=ogcaibb_pat_replace_me

# Hard rule: no remote LLM fallback. If Ollama is unreachable the daemon
# refuses requests with HTTP 503. Do not set OPENAI_API_KEY or ANTHROPIC_API_KEY.
